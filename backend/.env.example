# Backend v2 environment — see docs/v2/03-especificacion-v2-para-claude-code.md
# Copy to backend/.env for local development. Never commit the real .env.

# --- Database (Phase 1) ---
DATABASE_URL=postgresql+asyncpg://brdp:brdp@localhost:5432/brdp_manager

# --- Auth (Phase 2) ---
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=14
# Read once by backend/scripts/create_admin_user.py on first run. If unset,
# the script prompts interactively instead — never a hardcoded default.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- LLM proxy (Phase 3) ---
# Exactly one provider is active per deployment — see §3 point 6 for why
# these are NOT client-selectable (data-residency guarantee).
ACTIVE_LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_ENDPOINT=https://api.mistral.ai/v1/chat/completions
# A private/self-hosted Mistral endpoint may not accept the same model
# names as the public API -- change this rather than hardcoding a guess,
# if "mistral-medium-latest" isn't right for this deployment's endpoint.
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_EMBED_ENDPOINT=https://api.mistral.ai/v1/embeddings
MISTRAL_EMBED_MODEL=mistral-embed
QWEN_API_KEY=
QWEN_ENDPOINT=

# On a corporate network with SSL inspection (e.g. Zscaler), calls to the
# above endpoints fail with SSLCertVerificationError -- confirmed live,
# see README's "Troubleshooting: Corporate Network / SSL-Inspecting
# Proxy" #3. Same root cause as the npm/Node problems documented there
# (#1/#2), but Python needs its own trust anchor -- neither npm's fix nor
# Node's win-ca cover httpx.
#
# For LOCAL DEVELOPMENT, `pip install -e ".[dev]"` already fixes this --
# it pulls in pip-system-certs, which patches Python to trust the OS
# certificate store automatically (no import needed anywhere in this
# app's code, no path to find, no variable to set here or in the shell).
# Nothing below is needed if you installed that way.
#
# The two variables below are the MANUAL alternative (if you'd rather not
# add the dev dependency), and are what a real deployment needs anyway --
# pip-system-certs is dev-only, never in production. They are real OS
# environment variables consumed by Python's ssl module / httpx, NOT
# settings read by this app's Settings class -- putting them in THIS
# .env file does nothing, because pydantic-settings parses .env into the
# Settings object without exporting it to os.environ. Set them in your
# actual shell before starting uvicorn:
#   set SSL_CERT_FILE=C:\path\to\corporate-root-cert.pem      (cmd)
#   set REQUESTS_CA_BUNDLE=C:\path\to\corporate-root-cert.pem
#   ($env: instead of set, on PowerShell; export on Linux/Mac)

# --- CORS (Phase 3) ---
# JSON array of allowed origins — never "*" (docs/v2 §4.1).
CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]

# --- BREX XSD validation (Phase 3) ---
# Defaults to <repo root>/sources -- leave commented out unless the backend
# runs from somewhere that default can't resolve correctly (e.g. a
# container image that doesn't preserve the repo layout). An UNCOMMENTED
# but empty value here would override that good default with "" and break
# XSD loading, so this is commented rather than left blank like the
# optional values above.
# SOURCES_DIR=/path/to/sources
