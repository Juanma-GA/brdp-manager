# Backend settings: every variable that backend/app/core/config.py reads,
# with its default value and what it is for. Copy to backend/.env and change
# what you need; a variable left out of backend/.env takes the default shown
# here. Never commit the real .env (it has passwords and keys).
# backend/tests/test_env_example.py fails if this file and config.py differ.
# A production .env, step by step: docs/instalacion/ (README.md has the same
# list in Spanish).

# --- Environment ---
# "production" on a server (the session cookie gets the Secure flag, which a
# browser drops over plain HTTP, so leave "development" for local work).
ENVIRONMENT=development

# --- Database ---
# Always postgresql+asyncpg://. The default is the development database.
DATABASE_URL=postgresql+asyncpg://brdp:brdp@localhost:5432/brdp_manager
# The tests' own database (read by backend/tests and the npm test scripts,
# never by the app): its name must end in _test and differ from
# DATABASE_URL. `npm run test:db:create` creates it and adds this line to
# backend/.env. Never on a server.
# TEST_DATABASE_URL=postgresql+asyncpg://brdp:brdp@localhost:5432/brdp_manager_test

# --- Sessions ---
# Keys that sign the sessions, relative to backend/ (scripts/generate_rsa_keypair.py
# writes them; they are not in git).
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=14
# Seconds a session token already replaced by a refresh still works (a
# reload during a refresh, two tabs at once). Logout never leaves it. 0 = off.
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
# Read only by scripts/create_admin_user.py (it prompts if they are empty).
# The email needs a real domain: like the login, the script refuses
# reserved ones (.local, .localhost, .test, .invalid). Do not leave them here.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- AI provider ---
# One provider per deployment: "mistral" or "qwen" (embeddings -- Suggest,
# similar BRDPs -- only work with mistral). Not selectable from the browser.
ACTIVE_LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_ENDPOINT=https://api.mistral.ai/v1/chat/completions
# A private Mistral endpoint may use other model names: change it here.
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_EMBED_ENDPOINT=https://api.mistral.ai/v1/embeddings
# Changing the embeddings model makes every stored embedding obsolete.
MISTRAL_EMBED_MODEL=mistral-embed
# Only with ACTIVE_LLM_PROVIDER=qwen.
QWEN_API_KEY=
QWEN_ENDPOINT=
QWEN_CHAT_MODEL=qwen-plus
# Largest max_tokens the proxy accepts (the rule test asks for 16000).
LLM_MAX_TOKENS=16000
# Longest wait for the AI on a chat call, in seconds (until the first byte
# and between two bytes); over it, a 504. 0 = no limit.
LLM_REQUEST_TIMEOUT_SECONDS=300
# Chat calls to the AI per user; over a limit the call is refused (429)
# without calling the provider. 0 = no limit.
LLM_CALLS_PER_MINUTE=120
LLM_CALLS_PER_DAY=3000

# --- CORS ---
# JSON list of the addresses the browser uses -- never "*".
CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]

# --- Reference schemas ---
# Defaults to <repo root>/sources. Leave it commented: an uncommented but
# empty value replaces that default with "" and breaks BREX validation.
# SOURCES_DIR=/path/to/sources

# --- Excel import ---
# Largest workbook (bytes), its uncompressed size and its rows; over any of
# them the file is refused with the reason.
EXCEL_IMPORT_MAX_BYTES=10485760
EXCEL_IMPORT_MAX_UNCOMPRESSED_BYTES=209715200
EXCEL_IMPORT_MAX_ROWS=20000

# --- AI Extract ---
# Largest BREX/Schematron (bytes). If you raise it, raise the web server's
# upload limit too.
RULE_EXTRACT_MAX_BYTES=20971520
# Free text: at most these words and characters (refused, never cut).
EXTRACT_TEXT_MAX_WORDS=5000
EXTRACT_TEXT_MAX_CHARS=200000
# Longest literal quote kept for a decision.
EXTRACT_QUOTE_MAX_CHARS=20000

# --- Text limits ---
# Longest Title, and longest Definition / Proposal / refusal reason (Excel's
# cell limit, so everything saved can be exported). Over them, refused.
BRDP_TITLE_MAX_CHARS=2000
BRDP_TEXT_MAX_CHARS=32767
PROJECT_NAME_MAX_CHARS=200

# --- Interface ---
# Limits of the Records detail panel's width (px) saved per user.
UI_DETAIL_WIDTH_MIN=360
UI_DETAIL_WIDTH_MAX=4000

# --- Corporate network with SSL inspection ---
# Not a setting of this app: Python needs the corporate root certificate in
# the SSL_CERT_FILE environment variable of the uvicorn process (a value in
# this file does nothing). See docs/instalacion/README.md.
