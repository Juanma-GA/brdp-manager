# scripts/run-prompt-eval.mjs output -- a run artifact (real LLM responses
# and per-run pass/fail tables), never something to commit. cases.json
# itself (the fixed test cases) IS committed.
scripts/prompt-eval/report/
# Every saved run (C3): scripts/prompt-eval/runs/<commit>-<time>/ -- same
# reason, real LLM answers.
scripts/prompt-eval/runs/
# The report of each pass of scripts/run-project-rule-tests.mjs (every rule
# of a project tested): scripts/rule-test-runs/<project>-<date>/ -- real
# examples and results of the user's projects, never committed.
scripts/rule-test-runs/
