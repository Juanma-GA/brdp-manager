<?xml version="1.0" encoding="UTF-8"?>
<!-- RECONSTRUCTED, not the real file. A Schematron generated by Generate
     ("DITA 1.3 Xpath3.0") from 35 Navantia rules: BRDP-EXT-00001..00009 are
     the rules of public/brdp-template-dita-xpath3.xlsx and
     BRDP-EXT-00010..00035 the reconstructed ones of
     navantia-dita3-reconstructed.sch. The real 35-rule document generated on
     2026-10-15 is not in the repository: save it next to this one as
     navantia-dita3-generated-<anything>.sch and
     scripts/test-generate-vocabulary.mjs checks it too. -->
<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns="http://purl.oclc.org/dsdl/schematron" queryBinding="xslt3">
<sch:title>Navantia S80 (reconstruido) Business Rules Schematron (BRDP-D1) — combined, all 6 topic types</sch:title>
  <sch:ns prefix="xs" uri="http://www.w3.org/2001/XMLSchema"/>
  <sch:let name="colDe" value="function($cab as element()*, $rotulo as xs:string) as xs:string {                     string(($cab/entry[normalize-space(.) = $rotulo]/@colname)[1])                   }"/>
  <sch:let name="colPart" value="function($cab as element()*) as xs:string {                     string(($cab/entry[normalize-space(.) = 'Part']/@colname,                             $cab/entry[1]/@colname)[1])                   }"/>
  <sch:let name="valor" value="function($fila as element(), $col as xs:string) as xs:string {                     if ($col = '') then ''                     else if ($fila/entry[@colname = $col]) then                       normalize-space($fila/entry[@colname = $col][1])                     else                       let $abre  := ($fila/preceding-sibling::row[entry[@colname = $col]])[last()],                           $salto := count($fila/preceding-sibling::row)                                     - count($abre/preceding-sibling::row)                       return                         if (empty($abre)) then ''                         else if (number(($abre/entry[@colname = $col][1]/@morerows, '0')[1]) ge $salto)                              then normalize-space($abre/entry[@colname = $col][1])                              else ''                   }"/>
  <sch:let name="docFicha" value="function($tr as element()) as document-node()* {                     let $h    := string($tr/@href),                         $ruta := if (contains($h, '#')) then substring-before($h, '#') else $h                     return                       if ($ruta = '' or $tr/@scope = 'external' or starts-with($ruta, 'http'))                       then ()                       else let $u := resolve-uri($ruta, base-uri($tr))                            return if (doc-available($u)) then doc($u) else ()                   }"/>
  <sch:let name="nodoConref" value="function($n as element()) as element()* {                     if (empty($n/@conref)) then ()                     else                       let $c    := string($n/@conref),                           $ruta := if (contains($c, '#')) then substring-before($c, '#') else $c,                           $frag := if (contains($c, '#')) then substring-after($c, '#') else '',                           $id   := if (contains($frag, '/')) then substring-after($frag, '/') else $frag,                           $doc  := if ($ruta = '') then root($n)                                    else let $u := resolve-uri($ruta, base-uri($n))                                         return if (doc-available($u)) then doc($u) else ()                       return                         if (empty($doc) or $id = '') then ()                         else ($doc//*[@id = $id])[1]                   }"/>
  <sch:let name="conrefRoto" value="function($n as element()) as xs:boolean {                     exists($n/@conref) and empty($nodoConref($n))                   }"/>
  <sch:let name="yo" value="base-uri()"/>
  <sch:let name="mapas" value="for $mC in (for $n in 1 to count(tokenize($yo, '/')) - 1 return string-join(subsequence(tokenize($yo, '/'), 1, count(tokenize($yo, '/')) - $n), '/') || '/')[matches(., '^file:/+[A-Za-z]:/.+/$|^file:/+[^:]+/.+/$')], $mU in sort(uri-collection($mC)[matches(., '\.ditamap$', 'i')]) return (if (doc-available($mU)) then doc($mU) else ())[some $mE in .//*[@href][not(@scope = 'external')] satisfies resolve-uri(substring-before(concat($mE/@href, '#'), '#'), base-uri($mE)) = $yo]"/>
<sch:pattern id="p-BRDP-EXT-00001">
    <sch:rule context="*[title = ('LISTA DE MATERIAL OBLIGATORIO',                                   'LISTA DE MATERIAL IMPREVISTO',                                   'HERRAMIENTAS Y EQUIPOS DE PRUEBA')]                         //table[tgroup/thead/row/entry[normalize-space(.) = 'Cant.']]                         /tgroup/tbody/row"><sch:let name="cab" value="ancestor::tgroup[1]/thead/row[1]"/>
      <sch:let name="part" value="$valor(., $colPart($cab))"/>
      <sch:let name="cant" value="$valor(., $colDe($cab, 'Cant.'))"/>

      <sch:assert role="error" id="BRDP-EXT-00001" test="$part = '' or $cant != ''">
        En tablas con columna "Cant." dentro de los temas "LISTA DE MATERIAL OBLIGATORIO", "LISTA DE MATERIAL IMPREVISTO" o "HERRAMIENTAS Y EQUIPOS DE PRUEBA", la columna "Cant." no puede estar vac&#237;a cuando la columna "Part" tenga contenido.
      </sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00002">
    <sch:rule context="table[tgroup/thead/row/entry[normalize-space(.) = 'NCAGE']]/tgroup/tbody/row"><sch:let name="cab" value="ancestor::tgroup[1]/thead/row[1]"/>
      <sch:let name="part" value="$valor(., $colPart($cab))"/>
      <sch:let name="ncage" value="$valor(., $colDe($cab, 'NCAGE'))"/>

      <sch:assert role="error" id="BRDP-EXT-00002" test="$part = '' or $ncage = '-' or matches($ncage, '^[A-Z0-9]{5}$')">
        En tablas con columna "NCAGE", cada fila debe contener exactamente 5 caracteres alfanum&#233;ricos en may&#250;sculas (A-Z, 0-9) o "-" (solo si el dato es desconocido). Filas con la columna "Part" vac&#237;a est&#225;n exentas.
      </sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00003">
    <sch:rule context="table[tgroup/thead/row/entry[normalize-space(.) = 'Part Number']]/tgroup/tbody/row"><sch:let name="cab" value="ancestor::tgroup[1]/thead/row[1]"/>
      <sch:let name="part" value="$valor(., $colPart($cab))"/>
      <sch:let name="partNumber" value="$valor(., $colDe($cab, 'Part Number'))"/>

      <sch:assert role="error" id="BRDP-EXT-00003" test="$part = '' or $partNumber != ''">
        En tablas con columna "Part Number", cada fila debe indicar un valor; si se desconoce, debe indicarse con el car&#225;cter "-" en lugar de dejarse vac&#237;o. Filas con la columna "Part" vac&#237;a est&#225;n exentas.
      </sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00004">
    <sch:rule context="map"><sch:let name="docs" value="for $tr in //topicref[@href] return $docFicha($tr)"/>

      <sch:let name="clave" value="normalize-space((//keydef[tokenize(normalize-space(@keys), '\s+') = 'Escalon']                                        //keyword)[1])"/>

      <sch:let name="tablasPlan" value="$docs//*[normalize-space(title) = 'DATOS PARA LA PLANIFICACI&#211;N']                       //table[tgroup/thead/row/entry[normalize-space(.) = 'ESCAL&#211;N DE MANTENIMIENTO']]"/>

      <sch:let name="celdasProc" value="$docs//entry[not(parent::row/parent::thead)]                                   [p/b[normalize-space(.) = 'ESCAL&#211;N DE MANTENIMIENTO']]"/>

      <!-- Localizaci&#243;n de la celda de la planificaci&#243;n: por @colname del
           r&#243;tulo; si el r&#243;tulo no lo lleva, por posici&#243;n. En el .sch de
           xpath2 esto est&#225; escrito dos veces porque no hay funciones
           propias; aqu&#237; va una sola vez. -->
      <sch:let name="escalonPlan" value="function($t as element()) as xs:string {                         let $rotulo := ($t/tgroup/thead/row[1]                                           /entry[normalize-space(.) = 'ESCAL&#211;N DE MANTENIMIENTO'])[1],                             $celda  := (if ($rotulo/@colname)                                         then $t/tgroup/tbody/row[1]/entry[@colname = $rotulo/@colname]                                         else ($t/tgroup/tbody/row[1]/entry)                                                 [count($rotulo/preceding-sibling::entry) + 1])[1]                         return if ($celda//ph[@keyref = 'Escalon'])                                then $clave                                else normalize-space($celda)                       }"/>

      <sch:let name="escalonProc" value="function($c as element()) as xs:string {                         if ($c//ph[@keyref = 'Escalon'])                         then $clave                         else normalize-space(($c/p[not(b)])[1])                       }"/>

      <!-- Con "for ... return", no con fn:for-each: las funciones de orden
           superior de XPath 3.0 exigen que el par&#225;metro admita item(), y
           estas est&#225;n tipadas element(). Coercionarlas para lucir la
           llamada ser&#237;a cambiar el tipo por la forma. -->
      <sch:let name="valoresPlan" value="for $t in $tablasPlan return $escalonPlan($t)"/>
      <sch:let name="valoresProc" value="for $c in $celdasProc return $escalonProc($c)"/>

      <sch:assert role="error" id="BRDP-EXT-00004a" test="exists($tablasPlan) = exists($celdasProc)">
        El escal&#243;n de mantenimiento aparece solo en una de las dos hojas: la "HOJA DE DATOS DE PLANIFICACI&#211;N CONSOLIDADA" (tema "DATOS PARA LA PLANIFICACI&#211;N") y la "HOJA RESUMEN DE PROCEDIMIENTO" tienen que indicarlo las dos, y con el mismo valor.
      </sch:assert>

      <sch:assert role="error" id="BRDP-EXT-00004b" test="empty($tablasPlan) or (every $v in $valoresPlan satisfies $v != '')">
        La hoja de planificaci&#243;n no indica el escal&#243;n de mantenimiento: la celda est&#225; vac&#237;a, o usa &lt;ph keyref="Escalon"/&gt; y ning&#250;n ditamap declara esa clave. Sin ese valor no se puede comprobar que coincida con la HOJA RESUMEN DE PROCEDIMIENTO.
      </sch:assert>

      <sch:assert role="error" id="BRDP-EXT-00004c" test="empty($celdasProc) or (every $v in $valoresProc satisfies $v != '')">
        La HOJA RESUMEN DE PROCEDIMIENTO no indica el escal&#243;n de mantenimiento: la celda no trae valor, o usa &lt;ph keyref="Escalon"/&gt; y ning&#250;n ditamap declara esa clave. Sin ese valor no se puede comprobar que coincida con la hoja de planificaci&#243;n.
      </sch:assert>

      <!-- Los vac&#237;os se descartan: de esos ya avisan las dos asserts
           anteriores, y arrastrarlos aqu&#237; dar&#237;a dos avisos por el mismo
           hecho. -->
      <sch:assert role="error" id="BRDP-EXT-00004d" test="every $p in $valoresPlan[. != ''],                               $q in $valoresProc[. != ''] satisfies $p = $q">
        El escal&#243;n de mantenimiento de la HOJA RESUMEN DE PROCEDIMIENTO no coincide con el de la HOJA DE DATOS DE PLANIFICACI&#211;N CONSOLIDADA (tema "DATOS PARA LA PLANIFICACI&#211;N"). Planificaci&#243;n: <sch:value-of select="string-join(distinct-values($valoresPlan[. != '']), ', ')"/>. Procedimiento: <sch:value-of select="string-join(distinct-values($valoresProc[. != '']), ', ')"/>.
      </sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00005">
    <sch:rule context="table[tgroup/thead/row/entry[normalize-space(.) = 'NOC']]/tgroup/tbody/row"><sch:let name="cab" value="ancestor::tgroup[1]/thead/row[1]"/>
      <sch:let name="part" value="$valor(., $colPart($cab))"/>
      <sch:let name="noc" value="$valor(., $colDe($cab, 'NOC'))"/>

      <sch:assert role="error" id="BRDP-EXT-00005" test="$part = '' or $noc = '-' or matches($noc, '^[0-9]{13}$')">
        En tablas con columna "NOC", cada fila debe contener exactamente 13 valores num&#233;ricos (0-9) o "-" (solo si el dato es desconocido). Filas con la columna "Part" vac&#237;a est&#225;n exentas.
      </sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00006">
    <sch:rule context="*[title = 'LISTA DE MATERIAL OBLIGATORIO']                         //table[tgroup/thead/row/entry[contains(normalize-space(.), 'Documento T&#233;cnico')]                             and tgroup/thead/row/entry[normalize-space(.) = 'Marca']]                         /tgroup/tbody/row[preceding-sibling::row[entry[normalize-space(.) = 'Repuestos']]]"><sch:let name="colContiene" value="function($cab as element()*, $fragmento as xs:string) as xs:string {                     string(($cab/entry[contains(normalize-space(.), $fragmento)]/@colname)[1])                   }"/><sch:let name="cab" value="ancestor::tgroup[1]/thead/row[1]"/>
      <sch:let name="part" value="$valor(., $colPart($cab))"/>
      <sch:let name="docTec" value="$valor(., $colContiene($cab, 'Documento T&#233;cnico'))"/>
      <sch:let name="marca" value="$valor(., $colDe($cab, 'Marca'))"/>

      <!-- analyze-string parte el valor en las piezas que casan y las que
           no. Vale si hay al menos una figura y lo que queda fuera es
           solo el espacio que las separa: un "Figura 9 y la 10" tiene
           sobrante con contenido y no pasa. -->
      <sch:let name="figurasHalladas" value="analyze-string($docTec, 'Figura\s+[0-9]+')/*[local-name() = 'match']"/>
      <sch:let name="sobraEnDocTec" value="analyze-string($docTec, 'Figura\s+[0-9]+')                         /*[local-name() = 'non-match'][normalize-space(.) != '']"/>
      <sch:let name="marcas" value="tokenize(normalize-space($marca), '\s+')[. != '']"/>

      <sch:assert role="error" id="BRDP-EXT-00006a" test="$part = ''                         or (exists($figurasHalladas) and empty($sobraEnDocTec))">
        En "LISTA DE MATERIAL OBLIGATORIO", tras la fila "Repuestos", la columna "Documento T&#233;cnico / Manual T&#233;cnico / N&#250;mero de Plano" debe contener un valor con formato "Figura &lt;N&#250;mero&gt;" (ej. "Figura 9") y no puede estar vac&#237;a, salvo cuando la columna "Part" est&#233; vac&#237;a. Si la pieza sale en varias figuras, se indican todas con ese mismo formato. Valor le&#237;do: "<sch:value-of select="$docTec"/>".
      </sch:assert>

      <sch:assert role="error" id="BRDP-EXT-00006b" test="$part = ''                         or ($marca != '' and (every $m in $marcas satisfies matches($m, '^[0-9]+$')))">
        En "LISTA DE MATERIAL OBLIGATORIO", tras la fila "Repuestos", la columna "Marca" debe contener un valor num&#233;rico y no puede estar vac&#237;a, salvo cuando la columna "Part" est&#233; vac&#237;a. Si la pieza sale en varias figuras, lleva una marca por figura. Valor le&#237;do: "<sch:value-of select="$marca"/>".
      </sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00007">
  <sch:rule context="map">

<sch:let xmlns:xs="http://www.w3.org/2001/XMLSchema" name="docs" value="for $tr in //topicref[@href] return $docFicha($tr)"/>

<sch:let xmlns:xs="http://www.w3.org/2001/XMLSchema" name="docPrec" value="head($docs[normalize-space(*/title) = 'PRECAUCIONES DE SEGURIDAD'])"/>

<sch:assert xmlns:xs="http://www.w3.org/2001/XMLSchema" role="error" id="BRDP-EXT-00007" test="exists($docPrec)">
        El dosier no tiene la ficha titulada "PRECAUCIONES DE SEGURIDAD" entre las que referencia el ditamap, o no se ha podido leer. Mientras falte, NINGUNA advertencia est&#225; comprobada: este aviso sustituye a la comprobaci&#243;n, no la acompa&#241;a.
      </sch:assert>
  </sch:rule>
</sch:pattern>
<sch:pattern id="p-BRDP-EXT-00008">
  <sch:rule context="map">

<sch:let xmlns:xs="http://www.w3.org/2001/XMLSchema" name="esAdvertencia" value="function($n as element()) as xs:boolean {                     let $ref := $nodoConref($n)                     return $n/@type = 'warning' or $ref/@type = 'warning'                   }"/>

<sch:let xmlns:xs="http://www.w3.org/2001/XMLSchema" name="textoNota" value="function($n as element()) as xs:string {                     let $ref := $nodoConref($n)                     return normalize-space(string(($ref, $n)[1]))                   }"/>

<sch:let xmlns:xs="http://www.w3.org/2001/XMLSchema" name="docs" value="for $tr in //topicref[@href] return $docFicha($tr)"/>

<sch:let xmlns:xs="http://www.w3.org/2001/XMLSchema" name="docPrec" value="head($docs[normalize-space(*/title) = 'PRECAUCIONES DE SEGURIDAD'])"/>

<sch:let xmlns:xs="http://www.w3.org/2001/XMLSchema" name="pasosPrec" value="$docPrec//cmd ! normalize-space(.)"/>

<sch:let xmlns:xs="http://www.w3.org/2001/XMLSchema" name="notas" value="$docs//note[not(ancestor::ditacomponent)]                                  [not(ancestor::*[normalize-space(title) = 'PRECAUCIONES DE SEGURIDAD'])]                                  [$esAdvertencia(.)]                                  [not($conrefRoto(.))]"/>

<sch:let xmlns:xs="http://www.w3.org/2001/XMLSchema" name="huerfanas" value="distinct-values(                         for $n in $notas                         return (if ($textoNota($n) = $pasosPrec) then () else $textoNota($n)))"/>

<sch:assert xmlns:xs="http://www.w3.org/2001/XMLSchema" role="error" id="BRDP-EXT-00008" test="empty($docPrec) or empty($huerfanas)">
        Toda advertencia del procedimiento debe estar recogida, como paso, en "Precauciones de seguridad". Estas no aparecen all&#237; (<sch:value-of select="count($huerfanas)"/>): <sch:value-of select="string-join($huerfanas, ' | ')"/>. La comparaci&#243;n es por texto normalizado: los espacios y los saltos de l&#237;nea no cuentan.
      </sch:assert>
  </sch:rule>
</sch:pattern>
<sch:pattern id="p-BRDP-EXT-00009">
  <sch:rule context="map">

<sch:let xmlns:xs="http://www.w3.org/2001/XMLSchema" name="docs" value="for $tr in //topicref[@href] return $docFicha($tr)"/>

<sch:let xmlns:xs="http://www.w3.org/2001/XMLSchema" name="rotas" value="$docs//note[$conrefRoto(.)]"/>

<sch:assert xmlns:xs="http://www.w3.org/2001/XMLSchema" role="error" id="BRDP-EXT-00009" test="empty($rotas)">
        Hay notas que se reutilizan por conref y cuyo componente no se ha podido leer (<sch:value-of select="count($rotas)"/>): <sch:value-of select="string-join(distinct-values($rotas/@conref), ' | ')"/>. Si alguna es una advertencia, NO est&#225; comprobada contra Precauciones de seguridad. Mire que NOTAS_COMUNES est&#233; donde la ficha dice.
      </sch:assert>
  </sch:rule>
</sch:pattern>
<sch:pattern id="p-BRDP-EXT-00010">
    <sch:rule context="topic/title">
      <sch:assert id="BRDP-EXT-00010" role="error" test="not(matches(normalize-space(.), '^(nota|aviso)\s*:', 'i'))">El título de la ficha no puede empezar por «Nota:» ni «Aviso:».</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00011">
    <sch:rule context="*[normalize-space(title) = 'LISTA DE REFERENCIAS CONSOLIDADAS'] //section//*[self::p or self::entry[not(p)]][matches(normalize-space(.), '^\([a-z]\)')]">
      <sch:let name="letra" value="substring(normalize-space(.), 2, 1)"/>
      <sch:let name="seccion" value="ancestor::section[1]"/>
      <sch:let name="previos" value="count(preceding::*[self::p or self::entry[not(p)]][matches(normalize-space(.), '^\([a-z]\)')][ancestor::section[1] is $seccion])"/>
      <sch:assert id="BRDP-EXT-00011" role="error" test="string-to-codepoints($letra) = $previos + 97">En la lista de referencias consolidadas el apartado (<sch:value-of select="$letra"/>) está fuera de orden: los apartados van (a), (b), (c)… sin saltos ni repeticiones.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00012">
    <sch:rule context="row[not(parent::thead)][ancestor::*[normalize-space(title) = 'LISTA DE MATERIAL OBLIGATORIO']]">
      <sch:let name="item" value="normalize-space(entry[1])"/>
      <sch:let name="texto" value="string-join(ancestor::*[last()]//(cmd | p)[not(ancestor::table)] ! normalize-space(.), ' ')"/>
      <sch:assert id="BRDP-EXT-00012" role="warning" test="empty($mapas) or $item = '' or contains(lower-case($texto), lower-case($item)) or matches(normalize-space(entry[last()]), '^exento$', 'i')">Da aviso (warning, no error): el material «<sch:value-of select="$item"/>» de la lista de material obligatorio no se nombra en ningún paso de la ficha.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00013">
    <sch:rule context="row[not(parent::thead)][ancestor::*[normalize-space(title) = 'LISTA DE HERRAMIENTAS ESPECIALES']]">
      <sch:let name="item" value="normalize-space(entry[1])"/>
      <sch:let name="texto" value="string-join(ancestor::*[last()]//(cmd | p)[not(ancestor::table)] ! normalize-space(.), ' ')"/>
      <sch:assert id="BRDP-EXT-00013" role="warning" test="empty($mapas) or $item = '' or contains(lower-case($texto), lower-case($item)) or matches(normalize-space(entry[last()]), '^exento$', 'i')">Da aviso (warning, no error): la herramienta «<sch:value-of select="$item"/>» de la lista de herramientas especiales no se nombra en ningún paso de la ficha.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00014">
    <sch:rule context="entry">
      <sch:assert id="BRDP-EXT-00014" role="error" test="empty($mapas) or not(matches(normalize-space(.), '^TBD$', 'i'))">Celda con «TBD» en una ficha del dosier.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00015">
    <sch:rule context="*[text()][not(self::title)]">
      <sch:assert id="BRDP-EXT-00015" role="error" test="empty($mapas) or not(contains(., '  '))">Texto con dobles espacios en una ficha del dosier.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00016">
    <sch:rule context="p">
      <sch:assert id="BRDP-EXT-00016" role="error" test="empty($mapas) or string-length(normalize-space(.)) gt 0">Párrafo vacío en una ficha del dosier.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00017">
    <sch:rule context="entry[matches(normalize-space(.), '^FT-[0-9]{3}$')]">
      <sch:let name="fichas" value="for $h in $mapas//topicref[@href][not(@scope = 'external')] return (let $u := resolve-uri(substring-before(concat($h/@href, '#'), '#'), base-uri($h)) return if (doc-available($u)) then doc($u) else ())"/>
      <sch:assert id="BRDP-EXT-00017" role="error" test="empty($mapas) or normalize-space(.) = $fichas/*/@id">La ficha cita el código <sch:value-of select="normalize-space(.)"/>, que no corresponde a ninguna ficha del dosier.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00018">
    <sch:rule context="note[@type = 'warning']">
      <sch:let name="fichas" value="for $h in $mapas//topicref[@href][not(@scope = 'external')] return (let $u := resolve-uri(substring-before(concat($h/@href, '#'), '#'), base-uri($h)) return if (doc-available($u)) then doc($u) else ())"/>
      <sch:assert id="BRDP-EXT-00018" role="error" test="empty($mapas) or exists($fichas/*[@id = 'precauciones'])">Hay avisos pero el dosier no tiene la ficha de precauciones.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00019">
    <sch:rule context="step">
      <sch:assert id="BRDP-EXT-00019" role="error" test="empty($mapas) or exists(cmd)">Paso sin &lt;cmd&gt; en una ficha del dosier.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00020">
    <sch:rule context="table">
      <sch:assert id="BRDP-EXT-00020" role="error" test="empty($mapas) or exists(title)">Tabla sin título en una ficha del dosier.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00021">
    <sch:rule context="xref[not(@scope = 'external')]">
      <sch:assert id="BRDP-EXT-00021" role="error" test="empty($mapas) or exists(@href)">Referencia interna sin @href.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00022">
    <sch:rule context="section">
      <sch:assert id="BRDP-EXT-00022" role="error" test="empty($mapas) or exists(title)">Sección sin título en una ficha del dosier.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00023">
    <sch:rule context="topic">
      <sch:assert id="BRDP-EXT-00023" role="error" test="empty($mapas) or count($mapas) = 1">La ficha está referenciada desde más de un ditamap.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00024">
    <sch:rule context="fig">
      <sch:assert id="BRDP-EXT-00024" role="error" test="empty($mapas) or exists(image)">Figura sin imagen en una ficha del dosier.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00025">
    <sch:rule context="ul">
      <sch:assert id="BRDP-EXT-00025" role="error" test="empty($mapas) or count(li) ge 2">Lista con un solo elemento en una ficha del dosier.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00026">
    <sch:rule context="table">
      <sch:assert id="BRDP-EXT-00026" role="error" test="exists(title)">Toda tabla lleva título.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00027">
    <sch:rule context="cmd">
      <sch:assert id="BRDP-EXT-00027" role="error" test="empty($mapas) or not(ends-with(normalize-space(.), '.'))">La instrucción del paso termina en punto.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00028">
    <sch:rule context="xref[@scope = 'external']">
      <sch:assert id="BRDP-EXT-00028" role="error" test="exists(@format)">Una referencia externa lleva @format.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00029">
    <sch:rule context="image">
      <sch:assert id="BRDP-EXT-00029" role="error" test="exists(@href)">Toda imagen lleva @href.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00030">
    <sch:rule context="step">
      <sch:assert id="BRDP-EXT-00030" role="error" test="exists(cmd)">Todo paso lleva &lt;cmd&gt;.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00031">
    <sch:rule context="section">
      <sch:assert id="BRDP-EXT-00031" role="error" test="exists(title)">Toda sección lleva título.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00032">
    <sch:rule context="ul">
      <sch:assert id="BRDP-EXT-00032" role="error" test="count(li) ge 2">Una lista tiene al menos dos elementos.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00033">
    <sch:rule context="ph[@outputclass = 'codigo']">
      <sch:assert id="BRDP-EXT-00033" role="error" test="empty($mapas) or matches(normalize-space(.), '^FT-[0-9]{3}$')">Código mal formado en una ficha del dosier.</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00034">
    <sch:rule context="/*[matches(translate(lower-case(string(normalize-space(concat(@base, ' ', title)))), 'áéíóúüñ', 'aeiouun'), 'registro de inspecciones, pruebas y acciones de (reparacion|reacondicionamiento) en taller')]">
      <sch:let name="campos" value=".//thead//entry ! lower-case(normalize-space(.))"/>
      <sch:assert id="BRDP-EXT-00034a" role="error" test="$campos = 'fecha'">El registro de inspecciones, pruebas y acciones en taller no tiene el campo obligatorio «Fecha».</sch:assert>
      <sch:assert id="BRDP-EXT-00034b" role="error" test="$campos = 'firma'">El registro de inspecciones, pruebas y acciones en taller no tiene el campo obligatorio «Firma».</sch:assert>
    </sch:rule>
    <sch:rule context="/*[matches(translate(lower-case(string(normalize-space(concat(@base, ' ', title)))), 'áéíóúüñ', 'aeiouun'), 'registro de inspecciones, pruebas y acciones de (reparacion|reacondicionamiento) a bordo')]">
      <sch:let name="campos" value=".//thead//entry ! lower-case(normalize-space(.))"/>
      <sch:assert id="BRDP-EXT-00034c" role="error" test="$campos = 'fecha'">El registro de inspecciones, pruebas y acciones a bordo no tiene el campo obligatorio «Fecha».</sch:assert>
      <sch:assert id="BRDP-EXT-00034d" role="error" test="$campos = 'firma'">El registro de inspecciones, pruebas y acciones a bordo no tiene el campo obligatorio «Firma».</sch:assert>
    </sch:rule>
  </sch:pattern>
<sch:pattern id="p-BRDP-EXT-00035">
    <sch:rule context="li">
      <sch:assert id="BRDP-EXT-00035" role="error" test="empty($mapas) or string-length(normalize-space(.)) gt 0">Elemento de lista vacío.</sch:assert>
    </sch:rule>
  </sch:pattern>
</sch:schema>